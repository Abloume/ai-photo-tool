# 复制成 .env 后填自己的 key；不配置也能用，AI 建议会走离线规则
DEEPSEEK_API_KEY=
# 可选：默认 https://api.deepseek.com；用网关时填到 /v1 为止（程序自动补 /chat/completions）
DEEPSEEK_BASE_URL=
# 可选：默认 deepseek-flash（V4.1-Flash，支持看图）；deepseek-v4-pro 不支持图片输入
DEEPSEEK_MODEL=
# 可选：只给图片请求换一个模型，不填就用 DEEPSEEK_MODEL
AI_VISION_MODEL=
# 可选：设 1 开启思考模式（默认关闭，否则出标签要等几十秒）
AI_THINKING=

# ---- 图生图（可选）：不填 AI_IMAGE_MODEL 就只能生成提示词 ----
# 需要一个 OpenAI 兼容、且真的开通了图像渠道的模型，例：gpt-image-1 / doubao-seedream-4-0 / wanx-v1
AI_IMAGE_MODEL=
# 默认复用 DEEPSEEK_BASE_URL；单独指定时同样填到 /v1 为止
AI_IMAGE_BASE_URL=
# 默认复用 DEEPSEEK_API_KEY
AI_IMAGE_API_KEY=
# 默认 /images/edits（图生图）；只有文生图的模型填 /images/generations
AI_IMAGE_ENDPOINT=
# 默认 1024x1024
AI_IMAGE_SIZE=
